{
  "name": "airreg-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:with-webhooks": "node scripts/check-and-run-stripe.js",
    "dev:with-webhooks:win": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev-with-stripe.ps1",
    "dev:vercel": "next dev",
    "build": "prisma generate && next build",
    "build:dev": "next build --turbopack",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "cross-env ANALYZE=true next build",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:credits": "tsx prisma/seed-credits.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "credits:topup": "tsx -e \"import('./src/lib/cron/creditTopUp').then(m => m.triggerCreditTopUp())\"",
    "cron:free-credits": "tsx scripts/cron-free-credits.ts",
    "cron:free-credits:status": "tsx scripts/cron-free-credits.ts status",
    "cron:free-credits:force": "tsx scripts/cron-free-credits.ts force",
    "cron:free-credits:monitor": "tsx scripts/cron-free-credits.ts monitor",
    "test:free-credits": "tsx scripts/test-free-credits.ts",
    "sync:users": "tsx scripts/sync-users.ts",
    "create:test-user": "tsx scripts/create-test-user.ts",
    "get:current-user": "tsx scripts/get-current-user.ts",
    "list:supabase-users": "tsx scripts/list-supabase-users.ts",
    "test:credit-limit": "tsx scripts/test-credit-limit.ts",
    "test:credit-limit-max": "tsx scripts/test-credit-limit-max.ts",
    "check:subscription-dates": "tsx scripts/check-subscription-dates.ts",
    "test:date-display": "tsx scripts/test-date-display.ts",
    "make-admin": "tsx scripts/make-user-admin.ts",
    "init-user": "tsx scripts/init-user.ts"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@prisma/client": "^5.22.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.1",
    "@upstash/redis": "^1.35.6",
    "@vercel/analytics": "^1.5.0",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "next": "15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "stripe": "^16.12.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@next/bundle-analyzer": "^16.0.1",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/addon-vitest": "^9.1.10",
    "@storybook/nextjs-vite": "^9.1.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/aos": "^3.0.7",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.56.0",
    "prisma": "^5.22.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "glob": "^10.4.5"
  }
